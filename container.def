Bootstrap: docker
From: python:3.12.3

%files
    $PWD/apptainer_requirements.txt apptainer_requirements.txt

%post
    apt-get update && apt-get install -y \
    libgl1 \
    git \
    build-essential \
    libnlopt-dev \
    libnlopt-cxx-dev \
    libgoogle-glog-dev \
    cmake \
    libeigen3-dev \
    libboost-all-dev

    pip install --root-user-action=ignore -r apptainer_requirements.txt

%environment
    export PATH=/uav_trajectories/build:$PATH
